{
  "name": "Docs Builder (Pandoc + TeX + Noto)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "3.11" }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true
      },
      "extensions": [
        "yzhang.markdown-all-in-one",
        "shd101wyy.markdown-preview-enhanced",
        "ms-python.python"
      ]
    }
  },

  "postCreateCommand": "test -f scripts/requirements.txt && pip3 install -r scripts/requirements.txt || true",

  // ⬇️ IMPORTANT : dossier de travail = nom du dossier local
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  // Laisse VS Code faire le bind-mount par défaut (ne pas surcharger "mounts")
  "remoteUser": "vscode"
}
